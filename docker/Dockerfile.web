# UniGate web portal image (Next.js standalone output — docs/deployment.md).
#
# NEXT_PUBLIC_* values are inlined at build time, so they are build arguments here; the API host
# still follows the page host at runtime (apps/web/src/lib/api.ts) which is why an IP-based
# deployment works without rebuilding when the address changes.
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.web \
#     --build-arg NEXT_PUBLIC_API_URL=http://<host>:4000/api/v1 \
#     --build-arg NEXT_PUBLIC_UPLOAD_ORIGINS=http://<host>:9000 -t unigate/web .

# ── deps ──────────────────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS deps
RUN apk add --no-cache libc6-compat && corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /repo
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc ./
COPY apps/web/package.json apps/web/
COPY packages/types/package.json packages/types/
COPY packages/validation/package.json packages/validation/
COPY packages/tsconfig/package.json packages/tsconfig/
COPY packages/eslint-config/package.json packages/eslint-config/
RUN pnpm install --frozen-lockfile --filter @unigate/web...

# ── build ─────────────────────────────────────────────────────────────────────────────────────────
FROM deps AS build
ARG NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
ARG NEXT_PUBLIC_DEFAULT_LOCALE=ar
ARG NEXT_PUBLIC_UPLOAD_ORIGINS=
ARG NEXT_PUBLIC_MAP_TILE_URL=
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_DEFAULT_LOCALE=$NEXT_PUBLIC_DEFAULT_LOCALE \
    NEXT_PUBLIC_UPLOAD_ORIGINS=$NEXT_PUBLIC_UPLOAD_ORIGINS \
    NEXT_PUBLIC_MAP_TILE_URL=$NEXT_PUBLIC_MAP_TILE_URL \
    NEXT_TELEMETRY_DISABLED=1
COPY packages/tsconfig packages/tsconfig
COPY packages/types packages/types
COPY packages/validation packages/validation
COPY apps/web apps/web
RUN pnpm --filter @unigate/types build \
 && pnpm --filter @unigate/validation build \
 && pnpm --filter @unigate/web build

# ── runtime ───────────────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS runtime
RUN apk add --no-cache libc6-compat curl tini
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3001
WORKDIR /app
# The standalone tracer keeps the monorepo layout: server.js lives under apps/web.
COPY --from=build --chown=node:node /repo/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=node:node /repo/apps/web/public ./apps/web/public
USER node
EXPOSE 3001
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD curl -fsS -o /dev/null http://127.0.0.1:3001/ || exit 1
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/web/server.js"]
