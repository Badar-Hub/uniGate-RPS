# ─────────────────────────────────────────────────────────────────────────────
# UniGate — environment template
#
# Copy to `.env` and fill in real values. This file contains NO real values.
# Every key required by packages/config/src/env.ts must appear here; CI fails
# if one is missing (security.md §7.1).
#
# Secrets marked (secret) must be generated, never invented. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The process refuses to boot on placeholder-looking values (changeme, secret, …).
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Public web origin — reset/callback links are built from THIS, never from a request header
APP_URL=http://localhost:3001
# Public API origin
API_URL=http://localhost:4000
# Comma-separated browser origins allowed to call the API with credentials. Never "*".
CORS_ORIGINS=http://localhost:3001
# Serve /api/v1/docs — default false; forced off in production unless behind auth
API_DOCS_ENABLED=true

# ── Data stores ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://unigate:unigate@localhost:5433/unigate?schema=public
# Separate database for the migration-integrity and repository tests
TEST_DATABASE_URL=postgresql://unigate:unigate@localhost:5433/unigate_test?schema=public
REDIS_URL=redis://localhost:6379

# ── Object storage (MinIO locally, S3-compatible in production) ───────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=me-south-1
STORAGE_BUCKET=unigate-documents
STORAGE_QUARANTINE_BUCKET=unigate-quarantine
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true

# ── Cryptography (secret) ────────────────────────────────────────────────────
# ≥ 32 chars each; JWT_SECRET and JWT_REFRESH_SECRET must differ
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# base64-encoded 32 bytes — AES-256-GCM key for PII columns (*_encrypted)
ENCRYPTION_KEY=
# Key identifier embedded in ciphertext so rotation and cross-env detection work
ENCRYPTION_KEY_ID=dev-1
# HMAC peppers for blind indexes and OTP hashes — ≥ 32 chars, distinct from each other
BLIND_INDEX_PEPPER=
OTP_PEPPER=
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Global rate-limit tiers (security.md §6.8). Ceilings, not business rules. Defaults: on outside NODE_ENV=test.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_5MIN=600
RATE_LIMIT_ANON_PER_MIN=120
RATE_LIMIT_READS_PER_MIN=300
RATE_LIMIT_WRITES_PER_MIN=120
# Web Content-Security-Policy: report-only until go-live; violations are posted to the API at /platform/csp-report
CSP_ENFORCE=false

# ── Providers (choice is deployment config; behaviour is in system_settings) ─
# mock is forbidden in production
PAYMENT_PROVIDER=mock
# E-invoicing (ADR-007): none = plain invoices (no clearance, nothing claimed); mock = development stand-in, forbidden in production
EINVOICING_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
# console is forbidden in production
OTP_PROVIDER=console
# Malware scanning of uploaded documents: none | clamav. `none` accepts uploads UNSCANNED
# (no scanner procured yet — A-25); the API logs a warning at boot in production.
SCAN_PROVIDER=none
CLAMAV_HOST=
CLAMAV_PORT=3310
OTP_ALLOWED_COUNTRY_CODES=+966
# Server-side maps key — never reaches the browser
MAPS_SERVER_KEY=
# Referrer-restricted render-only key — intentionally public
NEXT_PUBLIC_MAPS_BROWSER_KEY=
# Notification channels: EMAIL console|mailhog|smtp|ses (console/mailhog dev-only), SMS console|unifonic|taqnyat|msegat|twilio (OQ-10), PUSH none|fcm
EMAIL_PROVIDER=mailhog
EMAIL_FROM=UniGate <no-reply@unigate.local>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMS_PROVIDER=console
# none | expo (Expo Push Service, ADR-011) | fcm (reserved)
PUSH_PROVIDER=none
# EAS access token for the Expo Push Service (optional; recommended so only the API can push to our tokens)
EXPO_PUSH_ACCESS_TOKEN=
# URL scheme of the mobile app: payment return URLs on this scheme are allow-listed next to APP_URL
MOBILE_DEEP_LINK_SCHEME=unigate

# ── Seeding (dev/staging only — the seed aborts if unset; production seeds no accounts)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Web app ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=ar
# Origins the browser uploads documents to directly (presigned URLs): the S3 / MinIO endpoint. Required before CSP_ENFORCE=true.
NEXT_PUBLIC_UPLOAD_ORIGINS=http://localhost:9000
