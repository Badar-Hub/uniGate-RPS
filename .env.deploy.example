# Configuration for docker-compose.prod.yml (docs/deployment.md).
#   cp .env.deploy.example .env.deploy && chmod 600 .env.deploy
# Compose reads this file twice: for ${…} interpolation (--env-file) and as the environment of the
# API / worker / migrate containers (env_file). DATABASE_URL, REDIS_URL and SMTP_HOST are set by the
# compose file to the service names and need no value here. Generate every secret with
#   openssl rand -base64 32          (ENCRYPTION_KEY must be exactly this: 32 bytes, base64)
#   openssl rand -hex 32             (the rest)
# The API refuses to boot on a placeholder-looking secret (packages/config/src/env.ts).

# ── Where the stack is reachable (browsers and phones use these; the API validates return URLs against them) ──
# Everything is https through the proxy (docker/nginx): the portal and /api on :443, MinIO on :9443.
# Certificates: scripts/deploy/make-certs.sh (private CA for an IP / LAN name) or a real issuer.
DEPLOY_HOST=192.0.2.10
APP_URL=https://192.0.2.10
API_URL=https://192.0.2.10
CORS_ORIGINS=https://192.0.2.10
NEXT_PUBLIC_API_URL=https://192.0.2.10/api/v1
NEXT_PUBLIC_UPLOAD_ORIGINS=https://192.0.2.10:9443
NEXT_PUBLIC_DEFAULT_LOCALE=ar
# Published ports on the host
HTTP_PORT=80
HTTPS_PORT=443
STORAGE_PORT=9443
MAILHOG_PORT=8025

# ── Runtime tier ─────────────────────────────────────────────────────────────
# staging = production build with the development providers still allowed (mock gateway, console
# OTP/SMS, MailHog). Switch to production only once a real payment gateway, an SMS vendor (B-9)
# and an SMTP relay are configured — the schema refuses to boot otherwise.
NODE_ENV=staging
LOG_LEVEL=info
API_DOCS_ENABLED=false
RATE_LIMIT_ENABLED=true
CSP_ENFORCE=false

# ── Data stores ──────────────────────────────────────────────────────────────
POSTGRES_USER=unigate
POSTGRES_PASSWORD=
POSTGRES_DB=unigate
STORAGE_ENDPOINT=https://192.0.2.10:9443
STORAGE_REGION=me-south-1
STORAGE_BUCKET=unigate-documents
STORAGE_QUARANTINE_BUCKET=unigate-quarantine
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true

# ── Secrets (all required) ───────────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1
BLIND_INDEX_PEPPER=
OTP_PEPPER=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_API_KEY=

# ── Providers ────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=mock
EINVOICING_PROVIDER=none
OTP_PROVIDER=console
OTP_ALLOWED_COUNTRY_CODES=+966
SCAN_PROVIDER=none
EMAIL_PROVIDER=mailhog
EMAIL_FROM=UniGate <no-reply@unigate.local>
SMS_PROVIDER=console
PUSH_PROVIDER=none
EXPO_PUSH_ACCESS_TOKEN=
MOBILE_DEEP_LINK_SCHEME=unigate
MAPS_SERVER_KEY=

# ── First admin (used by `pnpm db:seed` inside the api container; remove after the first login) ──
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
