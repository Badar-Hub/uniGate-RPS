{
  "name": "@unigate/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Platform-agnostic client for the UniGate API envelope (api.md §2/§4/§7): injectable transport, bearer-token mode, one transparent refresh, field-error and i18n-key helpers. Shared by the mobile app and (later) the web app.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@unigate/types": "workspace:*"
  },
  "devDependencies": {
    "@unigate/eslint-config": "workspace:*",
    "@unigate/tsconfig": "workspace:*",
    "eslint": "^9.15.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
