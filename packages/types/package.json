{
  "name": "@unigate/types",
  "version": "0.1.0",
  "private": true,
  "description": "Hand-written DTO interfaces, domain enums and transition maps. Has NO dependency on Prisma — by rule (architecture.md §3).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@unigate/eslint-config": "workspace:*",
    "@unigate/tsconfig": "workspace:*",
    "eslint": "^9.15.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
