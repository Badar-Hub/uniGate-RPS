{
  "name": "@unigate/validation",
  "version": "0.1.0",
  "private": true,
  "description": "Zod schemas shared by the API (request validation, OpenAPI generation) and the web app (form resolvers). One definition, no drift.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@unigate/types": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@unigate/eslint-config": "workspace:*",
    "@unigate/tsconfig": "workspace:*",
    "eslint": "^9.15.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
