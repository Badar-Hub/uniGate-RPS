# Base URL of the UniGate API as reachable FROM THE PHONE. Expo inlines EXPO_PUBLIC_* at bundle
# time, so restart `expo start` after changing it. On a LAN the phone cannot reach "localhost" —
# use the dev machine's LAN IP (the same address Expo Go connects to for the bundle).
EXPO_PUBLIC_API_URL=http://172.23.65.81:4000/api/v1

# Google Maps key for Android live tracking (react-native-maps). Optional: without it the
# tracking screen shows a coordinates card instead of the map. iOS uses Apple Maps.
# EXPO_PUBLIC_MAPS_ANDROID_KEY=
