{
  "name": "@unigate/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "UniGate mobile app — Expo (React Native) role-aware app for customers and vehicle owners; Arabic-first with RTL",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@tanstack/react-query": "^5.103.1",
    "@unigate/api-client": "workspace:*",
    "@unigate/types": "workspace:*",
    "@unigate/validation": "workspace:*",
    "expo": "~57.0.23",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.19",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18n-js": "^4.5.3",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@unigate/eslint-config": "workspace:*",
    "eslint": "^9.15.0",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.17.0",
    "globals": "^16.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "vitest": "^2.1.5"
  }
}
