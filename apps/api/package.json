{
  "name": "@unigate/api",
  "version": "0.1.0",
  "private": true,
  "description": "UniGate API — Express 5 modular monolith",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed/index.ts",
    "db:studio": "prisma studio",
    "openapi:generate": "tsx src/docs/generate.ts > openapi.json",
    "openapi:check": "tsx src/docs/check.ts",
    "admin:create": "tsx src/cli/create-admin.ts",
    "bench:argon2": "tsx src/cli/bench-argon2.ts",
    "e2e:seed": "tsx src/cli/e2e-seed.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@prisma/client": "^5.22.0",
    "@unigate/config": "workspace:*",
    "@unigate/types": "workspace:*",
    "@unigate/validation": "workspace:*",
    "argon2": "^0.41.1",
    "bullmq": "^6.3.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.10",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "@unigate/eslint-config": "workspace:*",
    "@unigate/tsconfig": "workspace:*",
    "eslint": "^9.15.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
