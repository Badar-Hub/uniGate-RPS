/// The availability guarantee (database.md §7.3). `period` is a tstzrange; the EXCLUDE
/// constraint lives in SQL. Prisma cannot express ranges, so the column is Unsupported and
/// written through a reviewed $executeRaw in fleet.calendar.repository.
model VehicleCalendarEntry {
  id                  String                   @id @db.Uuid
  vehicleId           String                   @map("vehicle_id") @db.Uuid
  entryType           CalendarEntryType        @map("entry_type")
  period              Unsupported("tstzrange")
  bookingId           String?                  @unique(map: "uq_vehicle_calendar_entries_booking") @map("booking_id") @db.Uuid
  maintenanceRecordId String?                  @unique(map: "uq_vehicle_calendar_entries_maintenance") @map("maintenance_record_id") @db.Uuid
  status              CalendarEntryStatus      @default(HELD)
  createdByUserId     String?                  @map("created_by_user_id") @db.Uuid
  notes               String?
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  vehicle           Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  booking           Booking?           @relation(fields: [bookingId], references: [id])
  maintenanceRecord MaintenanceRecord? @relation(fields: [maintenanceRecordId], references: [id])

  @@index([vehicleId, status])
  @@map("vehicle_calendar_entries")
}

model OwnerServiceArea {
