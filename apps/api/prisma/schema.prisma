model Region {
  id     String @id @db.Uuid
  code   String @unique(map: "uq_regions_code") @db.VarChar(16)
  nameEn String @map("name_en") @db.VarChar(120)
  nameAr String @map("name_ar") @db.VarChar(120)

  cities      City[]
  spoProfiles SpoProfile[]

  @@map("regions")
}

model City {
  id        String  @id @db.Uuid
  regionId  String  @map("region_id") @db.Uuid
  code      String  @unique(map: "uq_cities_code") @db.VarChar(24)
  nameEn    String  @map("name_en") @db.VarChar(120)
  nameAr    String  @map("name_ar") @db.VarChar(120)
  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)
  isActive  Boolean @default(true) @map("is_active")

  region              Region                     @relation(fields: [regionId], references: [id])
  customerDefaults    CustomerProfile[]
  corporateAddresses  CorporateCustomerProfile[]
  savedLocations      SavedLocation[]
  ownerServiceAreas   OwnerServiceArea[]
  vehiclesBased       Vehicle[]
  tripRequestsPickup  TripRequest[]              @relation("TripRequestPickupCity")
  tripRequestsDropoff TripRequest[]              @relation("TripRequestDropoffCity")
  bookingsPickup      Booking[]                  @relation("BookingPickupCity")
  bookingsDropoff     Booking[]                  @relation("BookingDropoffCity")

  @@index([regionId])
  @@map("cities")
}

model VehicleCategory {
  id                     String        @id @db.Uuid
  code                   String        @unique(map: "uq_vehicle_categories_code") @db.VarChar(48)
  nameEn                 String        @map("name_en") @db.VarChar(120)
  nameAr                 String        @map("name_ar") @db.VarChar(120)
  transportType          TransportType @map("transport_type")
  descriptionEn          String?       @map("description_en")
  descriptionAr          String?       @map("description_ar")
  iconKey                String?       @map("icon_key") @db.VarChar(48)
