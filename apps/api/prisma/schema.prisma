/// RANGE-partitioned monthly on occurred_at; append-only at the DB-role level (SQL migration).
model AuditLog {
  id            String        @db.Uuid
  actorUserId   String?       @map("actor_user_id") @db.Uuid
  actorType     ActorType     @map("actor_type")
  actorRoles    String[]      @map("actor_roles")
  action        String        @db.VarChar(96)
  entityType    String        @map("entity_type") @db.VarChar(64)
  entityId      String        @map("entity_id") @db.VarChar(128)
  beforeValue   Json?         @map("before_value")
  afterValue    Json?         @map("after_value")
  changedFields String[]      @map("changed_fields")
  ipAddress     String?       @map("ip_address") @db.Inet
  userAgent     String?       @map("user_agent")
  requestId     String?       @map("request_id") @db.Uuid
  severity      AuditSeverity @default(INFO)
  occurredAt    DateTime      @map("occurred_at") @db.Timestamptz

  @@id([id, occurredAt])
  @@index([entityType, entityId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([severity, occurredAt(sort: Desc)])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String       @id @db.Uuid
  aggregateType String       @map("aggregate_type") @db.VarChar(64)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(96)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0) @map("attempt_count")
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model IdempotencyKey {
  key            String            @id @db.VarChar(96)
  userId         String?           @map("user_id") @db.Uuid
  endpoint       String            @db.VarChar(160)
  requestHash    String            @map("request_hash") @db.Char(64)
  responseStatus Int?              @map("response_status") @db.SmallInt
  responseBody   Json?             @map("response_body")
  status         IdempotencyStatus @default(IN_PROGRESS)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz

  @@index([expiresAt])
  @@map("idempotency_keys")
}

model ExportJob {
  id                String          @id @db.Uuid
  requestedByUserId String          @map("requested_by_user_id") @db.Uuid
  reportCode        String          @map("report_code") @db.VarChar(64)
  format            ExportFormat
  filters           Json            @default("{}")
  status            ExportJobStatus @default(QUEUED)
  rowCount          Int?            @map("row_count")
  documentId        String?         @map("document_id") @db.Uuid
  errorMessage      String?         @map("error_message")
  expiresAt         DateTime?       @map("expires_at") @db.Timestamptz
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  requestedBy User @relation(fields: [requestedByUserId], references: [id])

  @@index([requestedByUserId, createdAt(sort: Desc)])
  @@map("export_jobs")
}
