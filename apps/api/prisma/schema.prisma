model Document {
  id                         String                     @id @db.Uuid
  documentTypeCode           String                     @map("document_type_code") @db.VarChar(48)
  userId                     String?                    @map("user_id") @db.Uuid
  ownerProfileId             String?                    @map("owner_profile_id") @db.Uuid
  driverProfileId            String?                    @map("driver_profile_id") @db.Uuid
  vehicleId                  String?                    @map("vehicle_id") @db.Uuid
  corporateCustomerProfileId String?                    @map("corporate_customer_profile_id") @db.Uuid
  expenseId                  String?                    @map("expense_id") @db.Uuid
  maintenanceRecordId        String?                    @map("maintenance_record_id") @db.Uuid
  tripProofId                String?                    @map("trip_proof_id") @db.Uuid
  storageBucket              String                     @map("storage_bucket") @db.VarChar(128)
  storageKey                 String                     @map("storage_key")
  originalFilename           String                     @map("original_filename") @db.VarChar(255)
  mimeType                   String                     @map("mime_type") @db.VarChar(128)
  sizeBytes                  BigInt                     @map("size_bytes")
  checksumSha256             String                     @map("checksum_sha256") @db.Char(64)
  uploadStatus               DocumentUploadStatus       @default(PENDING) @map("upload_status")
  verificationStatus         DocumentVerificationStatus @default(PENDING) @map("verification_status")
  verifiedByUserId           String?                    @map("verified_by_user_id") @db.Uuid
  verifiedAt                 DateTime?                  @map("verified_at") @db.Timestamptz
  rejectionReason            String?                    @map("rejection_reason")
  issueDate                  DateTime?                  @map("issue_date") @db.Date
  expiryDate                 DateTime?                  @map("expiry_date") @db.Date
  visibility                 DocumentVisibility         @default(PRIVATE)
  createdAt                  DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime                   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                  DateTime?                  @map("deleted_at") @db.Timestamptz

  documentType      DocumentType              @relation(fields: [documentTypeCode], references: [code])
  user              User?                     @relation("DocumentUser", fields: [userId], references: [id], onDelete: Cascade)
  ownerProfile      OwnerProfile?             @relation("DocumentOwner", fields: [ownerProfileId], references: [id], onDelete: Cascade)
  driverProfile     DriverProfile?            @relation("DocumentDriver", fields: [driverProfileId], references: [id], onDelete: Cascade)
  vehicle           Vehicle?                  @relation("DocumentVehicle", fields: [vehicleId], references: [id], onDelete: Cascade)
  corporateCustomer CorporateCustomerProfile? @relation("DocumentCorporate", fields: [corporateCustomerProfileId], references: [id], onDelete: Cascade)
  expense           Expense?                  @relation("DocumentExpense", fields: [expenseId], references: [id], onDelete: Cascade)
  maintenanceRecord MaintenanceRecord?        @relation("DocumentMaintenance", fields: [maintenanceRecordId], references: [id], onDelete: Cascade)
  tripProof         TripProof?                @relation("DocumentTripProof", fields: [tripProofId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([ownerProfileId])
  @@index([driverProfileId])
  @@index([verificationStatus])
  @@map("documents")
}

