model NotificationTemplate {
  id        String              @id @db.Uuid
  code      String              @db.VarChar(64)
  channel   NotificationChannel
  locale    String              @db.VarChar(5)
  subject   String?             @db.VarChar(200)
  body      String
  variables String[]
  category  String              @db.VarChar(48)
  isActive  Boolean             @default(true) @map("is_active")
  version   Int                 @default(1)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([code, channel, locale], map: "uq_notification_templates_code_channel_locale")
  @@map("notification_templates")
}

model Notification {
  id                String              @id @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  templateCode      String              @map("template_code") @db.VarChar(64)
  channel           NotificationChannel
  category          String              @db.VarChar(48)
  title             String?             @db.VarChar(200)
  body              String
  data              Json                @default("{}")
  status            NotificationStatus  @default(QUEUED)
  providerMessageId String?             @map("provider_message_id") @db.VarChar(128)
  errorMessage      String?             @map("error_message")
  dedupeKey         String?             @map("dedupe_key") @db.VarChar(160)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz
  readAt            DateTime?           @map("read_at") @db.Timestamptz
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  userId    String              @map("user_id") @db.Uuid
  category  String              @db.VarChar(48)
  channel   NotificationChannel
  isEnabled Boolean             @default(true) @map("is_enabled")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category, channel])
  @@map("notification_preferences")
}

model DeviceToken {
  id         String         @id @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  token      String         @unique(map: "uq_device_tokens_token")
