model Rating {
  id                String            @id @db.Uuid
  bookingId         String            @map("booking_id") @db.Uuid
  tripId            String?           @map("trip_id") @db.Uuid
  raterUserId       String            @map("rater_user_id") @db.Uuid
  raterRole         RaterRole         @map("rater_role")
  subjectType       RatingSubjectType @map("subject_type")
  subjectId         String            @map("subject_id") @db.Uuid
  score             Int               @db.SmallInt
  comment           String?
  status            RatingStatus      @default(PUBLISHED)
  moderatedByUserId String?           @map("moderated_by_user_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id])
  trip    Trip?   @relation(fields: [tripId], references: [id])

  @@unique([bookingId, raterUserId, subjectType, subjectId], map: "uq_ratings_once")
  @@index([subjectType, subjectId, status])
  @@map("ratings")
}

model Complaint {
  id               String               @id @db.Uuid
  complaintNumber  String               @unique(map: "uq_complaints_number") @map("complaint_number") @db.VarChar(24)
  raisedByUserId   String               @map("raised_by_user_id") @db.Uuid
  bookingId        String?              @map("booking_id") @db.Uuid
  tripId           String?              @map("trip_id") @db.Uuid
  againstType      ComplaintAgainstType @map("against_type")
  againstId        String?              @map("against_id") @db.Uuid
  category         String               @db.VarChar(48)
  subject          String               @db.VarChar(200)
  description      String
  severity         ComplaintSeverity    @default(MEDIUM)
  status           ComplaintStatus      @default(OPEN)
  assignedToUserId String?              @map("assigned_to_user_id") @db.Uuid
  resolution       String?
  resolvedAt       DateTime?            @map("resolved_at") @db.Timestamptz
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  booking Booking?        @relation(fields: [bookingId], references: [id])
  trip    Trip?           @relation(fields: [tripId], references: [id])
  notes   ComplaintNote[]

  @@index([status, severity])
  @@index([assignedToUserId, status])
  @@map("complaints")
}

model ComplaintNote {
  id           String   @id @db.Uuid
  complaintId  String   @map("complaint_id") @db.Uuid
  authorUserId String   @map("author_user_id") @db.Uuid
  body         String
  isInternal   Boolean  @default(true) @map("is_internal")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt])
  @@map("complaint_notes")
}

