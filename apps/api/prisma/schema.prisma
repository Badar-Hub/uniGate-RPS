  isActive            Boolean                   @default(true) @map("is_active")
  createdByUserId     String?                   @map("created_by_user_id") @db.Uuid
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  vehicleCategory VehicleCategory? @relation(fields: [vehicleCategoryId], references: [id])
  customerProfile CustomerProfile? @relation(fields: [customerProfileId], references: [id])
  ownerProfile    OwnerProfile?    @relation(fields: [ownerProfileId], references: [id])

  @@index([eventType, cancelledByRole, scope, isActive])
  @@map("cancellation_policies")
}

// ═════════════════════════════════════════════════════════════════════════════
// trips & tracking
// ═════════════════════════════════════════════════════════════════════════════

model Trip {
  id               String        @id @db.Uuid
  tripNumber       String        @unique(map: "uq_trips_number") @map("trip_number") @db.VarChar(24)
  bookingId        String        @unique(map: "uq_trips_booking") @map("booking_id") @db.Uuid
  vehicleId        String        @map("vehicle_id") @db.Uuid
  driverProfileId  String?       @map("driver_profile_id") @db.Uuid
  transportType    TransportType @map("transport_type")
  status           TripStatus    @default(BOOKED)
  actualStartAt    DateTime?     @map("actual_start_at") @db.Timestamptz
  actualEndAt      DateTime?     @map("actual_end_at") @db.Timestamptz
  startOdometerKm  Int?          @map("start_odometer_km")
  endOdometerKm    Int?          @map("end_odometer_km")
  actualDistanceKm Decimal?      @map("actual_distance_km") @db.Decimal(10, 2)
  driverNotes      String?       @map("driver_notes")
  customerNotes    String?       @map("customer_notes")
  delayMinutes     Int?          @map("delay_minutes")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  booking          Booking             @relation(fields: [bookingId], references: [id])
  vehicle          Vehicle             @relation(fields: [vehicleId], references: [id])
  driverProfile    DriverProfile?      @relation(fields: [driverProfileId], references: [id])
  statusHistory    TripStatusHistory[]
  proofs           TripProof[]
  trackingSessions TrackingSession[]
  ratings          Rating[]
  complaints       Complaint[]
  expenses         Expense[]

  @@index([status])
  @@index([driverProfileId, status])
  @@map("trips")
}

model TripStatusHistory {
  id              String      @id @db.Uuid
  tripId          String      @map("trip_id") @db.Uuid
  fromStatus      TripStatus? @map("from_status")
  toStatus        TripStatus  @map("to_status")
  changedByUserId String?     @map("changed_by_user_id") @db.Uuid
  actorType       ActorType   @map("actor_type")
  latitude        Decimal?    @db.Decimal(10, 7)
  longitude       Decimal?    @db.Decimal(10, 7)
  accuracyM       Decimal?    @map("accuracy_m") @db.Decimal(8, 2)
  note            String?
  occurredAt      DateTime    @map("occurred_at") @db.Timestamptz
  recordedAt      DateTime    @default(now()) @map("recorded_at") @db.Timestamptz

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, occurredAt])
  @@map("trip_status_history")
}

model TripProof {
  id                  String        @id @db.Uuid
  tripId              String        @map("trip_id") @db.Uuid
  proofType           TripProofType @map("proof_type")
  recipientName       String?       @map("recipient_name") @db.VarChar(160)
  recipientIdLast4    String?       @map("recipient_id_last4") @db.Char(4)
  signatureDocumentId String?       @map("signature_document_id") @db.Uuid
  latitude            Decimal?      @db.Decimal(10, 7)
  longitude           Decimal?      @db.Decimal(10, 7)
  notes               String?
  capturedByUserId    String?       @map("captured_by_user_id") @db.Uuid
  capturedAt          DateTime      @default(now()) @map("captured_at") @db.Timestamptz

  trip      Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  documents Document[] @relation("DocumentTripProof")

  @@index([tripId])
  @@map("trip_proofs")
}

model CurrentVehicleLocation {
  vehicleId  String         @id @map("vehicle_id") @db.Uuid
  latitude   Decimal        @db.Decimal(10, 7)
  longitude  Decimal        @db.Decimal(10, 7)
  accuracyM  Decimal?       @map("accuracy_m") @db.Decimal(8, 2)
  headingDeg Decimal?       @map("heading_deg") @db.Decimal(5, 2)
  speedKmh   Decimal?       @map("speed_kmh") @db.Decimal(6, 2)
  source     LocationSource
  tripId     String?        @map("trip_id") @db.Uuid
  recordedAt DateTime       @map("recorded_at") @db.Timestamptz
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("current_vehicle_locations")
}

model TrackingSession {
  id              String                @id @db.Uuid
  tripId          String                @map("trip_id") @db.Uuid
  vehicleId       String                @map("vehicle_id") @db.Uuid
  driverProfileId String?               @map("driver_profile_id") @db.Uuid
  providerCode    String                @map("provider_code") @db.VarChar(48)
  startedAt       DateTime              @default(now()) @map("started_at") @db.Timestamptz
  endedAt         DateTime?             @map("ended_at") @db.Timestamptz
  pointCount      Int                   @default(0) @map("point_count")
  totalDistanceKm Decimal               @default(0) @map("total_distance_km") @db.Decimal(10, 2)
  status          TrackingSessionStatus @default(ACTIVE)

  trip          Trip                   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vehicle       Vehicle                @relation(fields: [vehicleId], references: [id])
  driverProfile DriverProfile?         @relation(fields: [driverProfileId], references: [id])
  points        VehicleLocationPoint[]

  @@index([tripId])
  @@map("tracking_sessions")
}

/// RANGE-partitioned monthly on recorded_at (SQL migration). Partition key must be in the PK.
model VehicleLocationPoint {
  id                String   @db.Uuid
  trackingSessionId String   @map("tracking_session_id") @db.Uuid
  vehicleId         String   @map("vehicle_id") @db.Uuid
  latitude          Decimal  @db.Decimal(10, 7)
  longitude         Decimal  @db.Decimal(10, 7)
  accuracyM         Decimal? @map("accuracy_m") @db.Decimal(8, 2)
  headingDeg        Decimal? @map("heading_deg") @db.Decimal(5, 2)
  speedKmh          Decimal? @map("speed_kmh") @db.Decimal(6, 2)
  recordedAt        DateTime @map("recorded_at") @db.Timestamptz
  receivedAt        DateTime @default(now()) @map("received_at") @db.Timestamptz

  trackingSession TrackingSession @relation(fields: [trackingSessionId], references: [id], onDelete: Cascade)
  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@id([id, recordedAt])
  @@index([trackingSessionId, recordedAt])
  @@map("vehicle_location_points")
}

// ═════════════════════════════════════════════════════════════════════════════
// payments
// ═════════════════════════════════════════════════════════════════════════════

model Payment {
  id                 String             @id @db.Uuid
  paymentNumber      String             @unique(map: "uq_payments_number") @map("payment_number") @db.VarChar(24)
  bookingId          String?            @map("booking_id") @db.Uuid
  invoiceId          String?            @map("invoice_id") @db.Uuid
  customerProfileId  String             @map("customer_profile_id") @db.Uuid
  purpose            PaymentPurpose
  amount             Decimal            @db.Decimal(14, 2)
  currency           String             @default("SAR") @db.Char(3)
  status             PaymentStatus      @default(PENDING)
  providerCode       String             @map("provider_code") @db.VarChar(48)
  providerPaymentId  String?            @map("provider_payment_id") @db.VarChar(128)
  paymentMethodType  PaymentMethodType? @map("payment_method_type")
  paymentMethodLast4 String?            @map("payment_method_last4") @db.Char(4)
  authorizedAt       DateTime?          @map("authorized_at") @db.Timestamptz
  paidAt             DateTime?          @map("paid_at") @db.Timestamptz
  failedAt           DateTime?          @map("failed_at") @db.Timestamptz
  failureCode        String?            @map("failure_code") @db.VarChar(64)
  failureMessage     String?            @map("failure_message")
  expiresAt          DateTime?          @map("expires_at") @db.Timestamptz
  idempotencyKey     String?            @map("idempotency_key") @db.VarChar(64)
  metadata           Json               @default("{}")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  booking         Booking?              @relation(fields: [bookingId], references: [id])
  invoice         Invoice?              @relation(fields: [invoiceId], references: [id])
  customerProfile CustomerProfile       @relation(fields: [customerProfileId], references: [id])
  transactions    PaymentTransaction[]
  refunds         Refund[]
  webhookEvents   PaymentWebhookEvent[]
  ledgerEntries   LedgerEntry[]

  @@index([bookingId])
  @@index([invoiceId])
  @@index([customerProfileId, createdAt(sort: Desc)])
  @@index([providerCode, providerPaymentId])
  @@map("payments")
}

model PaymentTransaction {
  id                      String                   @id @db.Uuid
  paymentId               String                   @map("payment_id") @db.Uuid
  type                    PaymentTransactionType
  amount                  Decimal                  @db.Decimal(14, 2)
  currency                String                   @default("SAR") @db.Char(3)
  status                  PaymentTransactionStatus
  providerTransactionId   String?                  @map("provider_transaction_id") @db.VarChar(128)
  providerResponseCode    String?                  @map("provider_response_code") @db.VarChar(64)
  requestPayloadRedacted  Json?                    @map("request_payload_redacted")
  responsePayloadRedacted Json?                    @map("response_payload_redacted")
  occurredAt              DateTime                 @default(now()) @map("occurred_at") @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, occurredAt])
  @@map("payment_transactions")
}

model Refund {
  id                String       @id @db.Uuid
  refundNumber      String       @unique(map: "uq_refunds_number") @map("refund_number") @db.VarChar(24)
  paymentId         String       @map("payment_id") @db.Uuid
  bookingId         String?      @map("booking_id") @db.Uuid
  amount            Decimal      @db.Decimal(14, 2)
  currency          String       @default("SAR") @db.Char(3)
  reasonCode        String       @map("reason_code") @db.VarChar(48)
  reasonText        String?      @map("reason_text")
  status            RefundStatus @default(REQUESTED)
  requestedByUserId String?      @map("requested_by_user_id") @db.Uuid
  approvedByUserId  String?      @map("approved_by_user_id") @db.Uuid
  providerRefundId  String?      @map("provider_refund_id") @db.VarChar(128)
  processedAt       DateTime?    @map("processed_at") @db.Timestamptz
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  payment       Payment       @relation(fields: [paymentId], references: [id])
  booking       Booking?      @relation(fields: [bookingId], references: [id])
  ledgerEntries LedgerEntry[]

  @@index([paymentId])
  @@map("refunds")
}

model PaymentMethodToken {
  id                String            @id @db.Uuid
  customerProfileId String            @map("customer_profile_id") @db.Uuid
  providerCode      String            @map("provider_code") @db.VarChar(48)
  providerToken     String            @map("provider_token")
  methodType        PaymentMethodType @map("method_type")
  brand             String?           @db.VarChar(32)
  last4             String?           @db.Char(4)
  expiryMonth       Int?              @map("expiry_month") @db.SmallInt
  expiryYear        Int?              @map("expiry_year") @db.SmallInt
  isDefault         Boolean           @default(false) @map("is_default")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@index([customerProfileId])
  @@map("payment_method_tokens")
}

model PaymentWebhookEvent {
  id               String                  @id @db.Uuid
  providerCode     String                  @map("provider_code") @db.VarChar(48)
  providerEventId  String                  @map("provider_event_id") @db.VarChar(128)
  eventType        String                  @map("event_type") @db.VarChar(96)
  signatureHeader  String?                 @map("signature_header")
  signatureValid   Boolean                 @map("signature_valid")
  rawPayload       Json                    @map("raw_payload")
  httpHeaders      Json                    @default("{}") @map("http_headers")
  receivedAt       DateTime                @default(now()) @map("received_at") @db.Timestamptz
  processingStatus WebhookProcessingStatus @default(RECEIVED) @map("processing_status")
  processedAt      DateTime?               @map("processed_at") @db.Timestamptz
  attemptCount     Int                     @default(0) @map("attempt_count")
  lastError        String?                 @map("last_error")
  relatedPaymentId String?                 @map("related_payment_id") @db.Uuid

  relatedPayment Payment? @relation(fields: [relatedPaymentId], references: [id])

  @@unique([providerCode, providerEventId], map: "uq_webhook_provider_event")
  @@index([processingStatus, receivedAt])
  @@map("payment_webhook_events")
}

// ═════════════════════════════════════════════════════════════════════════════
// finance
// ═════════════════════════════════════════════════════════════════════════════

model CommissionRule {
  id                String                    @id @db.Uuid
  name              String                    @db.VarChar(120)
  scope             CommissionScope
  vehicleCategoryId String?                   @map("vehicle_category_id") @db.Uuid
  ownerProfileId    String?                   @map("owner_profile_id") @db.Uuid
  transportType     TransportType?            @map("transport_type")
  calculationType   CommissionCalculationType @map("calculation_type")
  percentageRate    Decimal?                  @map("percentage_rate") @db.Decimal(6, 4)
  fixedAmount       Decimal?                  @map("fixed_amount") @db.Decimal(14, 2)
  basis             CommissionBasis           @default(NET_OF_VAT)
  minAmount         Decimal?                  @map("min_amount") @db.Decimal(14, 2)
  maxAmount         Decimal?                  @map("max_amount") @db.Decimal(14, 2)
  currency          String                    @default("SAR") @db.Char(3)
  priority          Int                       @default(0)
  effectiveFrom     DateTime                  @map("effective_from") @db.Timestamptz
  effectiveTo       DateTime?                 @map("effective_to") @db.Timestamptz
  isActive          Boolean                   @default(true) @map("is_active")
  createdByUserId   String?                   @map("created_by_user_id") @db.Uuid
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  vehicleCategory VehicleCategory?           @relation(fields: [vehicleCategoryId], references: [id])
  ownerProfile    OwnerProfile?              @relation(fields: [ownerProfileId], references: [id])
  snapshots       BookingFinancialSnapshot[]

  @@index([scope, isActive, effectiveFrom])
  @@map("commission_rules")
}

model BookingFinancialSnapshot {
  id                         String           @id @db.Uuid
  bookingId                  String           @unique(map: "uq_booking_financial_snapshots_booking") @map("booking_id") @db.Uuid
  grossAmount                Decimal          @map("gross_amount") @db.Decimal(14, 2)
  vatRate                    Decimal          @map("vat_rate") @db.Decimal(6, 4)
  vatAmount                  Decimal          @map("vat_amount") @db.Decimal(14, 2)
  netOfVatAmount             Decimal          @map("net_of_vat_amount") @db.Decimal(14, 2)
  commissionRuleId           String?          @map("commission_rule_id") @db.Uuid
  commissionRuleSnapshot     Json             @default("{}") @map("commission_rule_snapshot")
  commissionBasis            CommissionBasis? @map("commission_basis")
  commissionRate             Decimal?         @map("commission_rate") @db.Decimal(6, 4)
  commissionAmount           Decimal          @default(0) @map("commission_amount") @db.Decimal(14, 2)
  commissionSource           CommissionSource @map("commission_source")
  commissionOverrideSnapshot Json?            @map("commission_override_snapshot")
  commissionVatAmount        Decimal          @default(0) @map("commission_vat_amount") @db.Decimal(14, 2)
  paymentFeeAmount           Decimal          @default(0) @map("payment_fee_amount") @db.Decimal(14, 2)
  paymentFeeSnapshot         Json             @default("{}") @map("payment_fee_snapshot")
  ownerGrossAmount           Decimal          @map("owner_gross_amount") @db.Decimal(14, 2)
  ownerNetAmount             Decimal          @map("owner_net_amount") @db.Decimal(14, 2)
  spoCommissionAmount        Decimal          @default(0) @map("spo_commission_amount") @db.Decimal(14, 2)
  spoRuleSnapshot            Json             @default("{}") @map("spo_rule_snapshot")
  vatTreatment               VatTreatment     @map("vat_treatment")
  ownerVatRegisteredSnapshot Boolean          @map("owner_vat_registered_snapshot")
  ownerVatNumberSnapshot     String?          @map("owner_vat_number_snapshot") @db.VarChar(15)
  currency                   String           @default("SAR") @db.Char(3)
  computedAt                 DateTime         @default(now()) @map("computed_at") @db.Timestamptz
  calculationVersion         Int              @map("calculation_version")

  booking        Booking         @relation(fields: [bookingId], references: [id])
  commissionRule CommissionRule? @relation(fields: [commissionRuleId], references: [id])

  @@map("booking_financial_snapshots")
}

model LedgerAccount {
  id       String            @id @db.Uuid
  code     String            @unique(map: "uq_ledger_accounts_code") @db.VarChar(48)
  nameEn   String            @map("name_en") @db.VarChar(120)
  nameAr   String            @map("name_ar") @db.VarChar(120)
  type     LedgerAccountType
  isActive Boolean           @default(true) @map("is_active")

  entries LedgerEntry[]

  @@map("ledger_accounts")
}

model LedgerEntry {
  id                 String          @id @db.Uuid
  transactionGroupId String          @map("transaction_group_id") @db.Uuid
  ledgerAccountId    String          @map("ledger_account_id") @db.Uuid
  direction          LedgerDirection
  amount             Decimal         @db.Decimal(14, 2)
  currency           String          @default("SAR") @db.Char(3)
  ownerProfileId     String?         @map("owner_profile_id") @db.Uuid
  customerProfileId  String?         @map("customer_profile_id") @db.Uuid
  bookingId          String?         @map("booking_id") @db.Uuid
  paymentId          String?         @map("payment_id") @db.Uuid
  settlementId       String?         @map("settlement_id") @db.Uuid
  refundId           String?         @map("refund_id") @db.Uuid
  invoiceId          String?         @map("invoice_id") @db.Uuid
  description        String
  occurredAt         DateTime        @map("occurred_at") @db.Timestamptz
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz

  account    LedgerAccount @relation(fields: [ledgerAccountId], references: [id])
  booking    Booking?      @relation(fields: [bookingId], references: [id])
  payment    Payment?      @relation(fields: [paymentId], references: [id])
  settlement Settlement?   @relation(fields: [settlementId], references: [id])
  refund     Refund?       @relation(fields: [refundId], references: [id])
  invoice    Invoice?      @relation(fields: [invoiceId], references: [id])

  @@index([transactionGroupId])
  @@index([ledgerAccountId, occurredAt])
  @@index([ownerProfileId, ledgerAccountId])
  @@index([customerProfileId, ledgerAccountId])
  @@map("ledger_entries")
}

model Settlement {
  id                String           @id @db.Uuid
  settlementNumber  String           @unique(map: "uq_settlements_number") @map("settlement_number") @db.VarChar(24)
  ownerProfileId    String           @map("owner_profile_id") @db.Uuid
  periodStart       DateTime         @map("period_start") @db.Timestamptz
  periodEnd         DateTime         @map("period_end") @db.Timestamptz
  grossAmount       Decimal          @default(0) @map("gross_amount") @db.Decimal(14, 2)
  commissionAmount  Decimal          @default(0) @map("commission_amount") @db.Decimal(14, 2)
  adjustmentsAmount Decimal          @default(0) @map("adjustments_amount") @db.Decimal(14, 2)
  netPayableAmount  Decimal          @default(0) @map("net_payable_amount") @db.Decimal(14, 2)
  currency          String           @default("SAR") @db.Char(3)
  status            SettlementStatus @default(DRAFT)
  bankAccountId     String?          @map("bank_account_id") @db.Uuid
  paymentReference  String?          @map("payment_reference") @db.VarChar(128)
