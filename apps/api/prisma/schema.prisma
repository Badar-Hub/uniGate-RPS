  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt              DateTime?                @map("deleted_at") @db.Timestamptz

  ownerProfile         OwnerProfile              @relation(fields: [ownerProfileId], references: [id])
  category             VehicleCategory           @relation(fields: [vehicleCategoryId], references: [id])
  make                 VehicleMake?              @relation(fields: [vehicleMakeId], references: [id])
  model                VehicleModel?             @relation(fields: [vehicleModelId], references: [id])
  gpsDevice            GpsDevice?                @relation(fields: [gpsDeviceId], references: [id])
