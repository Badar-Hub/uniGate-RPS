  correctsInvoiceId          String?                @map("corrects_invoice_id") @db.Uuid
  billingPeriodStart         DateTime?              @map("billing_period_start") @db.Date
  billingPeriodEnd           DateTime?              @map("billing_period_end") @db.Date
  sellerVatNumber            String                 @map("seller_vat_number") @db.VarChar(15)
  buyerVatNumber             String?                @map("buyer_vat_number") @db.VarChar(15)
  lineGranularitySnapshot    InvoiceLineGranularity @default(ORDER) @map("line_granularity_snapshot")
  subtotalAmount             Decimal                @map("subtotal_amount") @db.Decimal(14, 2)
  vatAmount                  Decimal                @map("vat_amount") @db.Decimal(14, 2)
  totalAmount                Decimal                @map("total_amount") @db.Decimal(14, 2)
  paidAmount                 Decimal                @default(0) @map("paid_amount") @db.Decimal(14, 2)
  outstandingAmount          Decimal                @map("outstanding_amount") @db.Decimal(14, 2)
  currency                   String                 @default("SAR") @db.Char(3)
  issueDate                  DateTime               @map("issue_date") @db.Date
  supplyDate                 DateTime               @map("supply_date") @db.Date
  dueDate                    DateTime               @map("due_date") @db.Date
  status                     InvoiceStatus          @default(DRAFT)
  pdfDocumentId              String?                @map("pdf_document_id") @db.Uuid
  // e-invoicing (database.md §12.7)
  einvoiceUuid               String?                @map("einvoice_uuid") @db.Uuid
  icv                        BigInt?
  previousInvoiceHash        String?                @map("previous_invoice_hash")
  invoiceHash                String?                @map("invoice_hash")
  cryptographicStamp         String?                @map("cryptographic_stamp")
  qrCodeTlv                  String?                @map("qr_code_tlv")
  xmlDocumentId              String?                @map("xml_document_id") @db.Uuid
  clearedXmlDocumentId       String?                @map("cleared_xml_document_id") @db.Uuid
  clearanceStatus            ClearanceStatus        @default(NOT_REQUIRED) @map("clearance_status")
  clearanceSubmittedAt       DateTime?              @map("clearance_submitted_at") @db.Timestamptz
  clearanceCompletedAt       DateTime?              @map("clearance_completed_at") @db.Timestamptz
  clearanceResponse          Json?                  @map("clearance_response")
  clearanceAttemptCount      Int                    @default(0) @map("clearance_attempt_count")
  reportingDueAt             DateTime?              @map("reporting_due_at") @db.Timestamptz
  providerReference          String?                @map("provider_reference") @db.VarChar(128)
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  issuedTo          CustomerProfile           @relation(fields: [issuedToCustomerProfileId], references: [id])
  corporateCustomer CorporateCustomerProfile? @relation(fields: [corporateCustomerProfileId], references: [id])
  corrects          Invoice?                  @relation("InvoiceCorrection", fields: [correctsInvoiceId], references: [id])
  correctedBy       Invoice[]                 @relation("InvoiceCorrection")
  lines             InvoiceLine[]
  payments          Payment[]
  ledgerEntries     LedgerEntry[]

  @@index([issuedToCustomerProfileId, issueDate(sort: Desc)])
  @@index([status, dueDate])
  @@index([clearanceStatus])
  @@map("invoices")
}

model InvoiceLine {
  id            String          @id @db.Uuid
  invoiceId     String          @map("invoice_id") @db.Uuid
  lineType      InvoiceLineType @map("line_type")
  tripRequestId String?         @map("trip_request_id") @db.Uuid
  bookingId     String?         @map("booking_id") @db.Uuid
  descriptionEn String          @map("description_en")
  descriptionAr String          @map("description_ar")
  quantity      Decimal         @default(1) @db.Decimal(10, 2)
  unitAmount    Decimal         @map("unit_amount") @db.Decimal(14, 2)
  netAmount     Decimal         @map("net_amount") @db.Decimal(14, 2)
  vatRate       Decimal         @map("vat_rate") @db.Decimal(6, 4)
  vatAmount     Decimal         @map("vat_amount") @db.Decimal(14, 2)
  totalAmount   Decimal         @map("total_amount") @db.Decimal(14, 2)
  vatCategory   String          @default("S") @map("vat_category") @db.Char(1)
  sortOrder     Int             @default(0) @map("sort_order")

  invoice     Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tripRequest TripRequest?         @relation(fields: [tripRequestId], references: [id])
  booking     Booking?             @relation(fields: [bookingId], references: [id])
  bookings    InvoiceLineBooking[]

  @@index([invoiceId, sortOrder])
  @@map("invoice_lines")
}

/// Which bookings an ORDER line covers — keeps "one live invoice per booking" intact when a
/// line aggregates many (database.md §12.6, FR-FINANCE-17).
model InvoiceLineBooking {
  invoiceLineId String @map("invoice_line_id") @db.Uuid
  bookingId     String @unique(map: "uq_invoice_line_bookings_booking") @map("booking_id") @db.Uuid

  invoiceLine InvoiceLine @relation(fields: [invoiceLineId], references: [id], onDelete: Cascade)
  booking     Booking     @relation(fields: [bookingId], references: [id])

  @@id([invoiceLineId, bookingId])
  @@map("invoice_line_bookings")
}

/// The supplier's (owner's) invoice TO UniGate for a booking — supplier-issued and verified,
/// or self-billed under Art 53(2) and accepted. Releases the settlement hold (FR-FINANCE-25).
model SupplierInvoice {
  id                    String                @id @db.Uuid
  ownerProfileId        String                @map("owner_profile_id") @db.Uuid
  bookingId             String                @map("booking_id") @db.Uuid
  kind                  SupplierInvoiceKind
  status                SupplierInvoiceStatus @default(PENDING)
  supplierInvoiceNumber String?               @map("supplier_invoice_number") @db.VarChar(64)
  sellerVatNumber       String                @map("seller_vat_number") @db.VarChar(15)
  netAmount             Decimal               @map("net_amount") @db.Decimal(14, 2)
  vatAmount             Decimal               @map("vat_amount") @db.Decimal(14, 2)
  totalAmount           Decimal               @map("total_amount") @db.Decimal(14, 2)
  currency              String                @default("SAR") @db.Char(3)
  issueDate             DateTime              @map("issue_date") @db.Date
  einvoiceUuid          String?               @map("einvoice_uuid") @db.Uuid
  qrVerifiedAt          DateTime?             @map("qr_verified_at") @db.Timestamptz
  pdfDocumentId         String?               @map("pdf_document_id") @db.Uuid
  xmlDocumentId         String?               @map("xml_document_id") @db.Uuid
  agreementId           String?               @map("agreement_id") @db.Uuid
  providerReference     String?               @map("provider_reference") @db.VarChar(128)
  verifiedByUserId      String?               @map("verified_by_user_id") @db.Uuid
  verifiedAt            DateTime?             @map("verified_at") @db.Timestamptz
  rejectionReason       String?               @map("rejection_reason")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  ownerProfile    OwnerProfile          @relation(fields: [ownerProfileId], references: [id])
  booking         Booking               @relation(fields: [bookingId], references: [id])
  agreement       SelfBillingAgreement? @relation(fields: [agreementId], references: [id])
  settlementLines SettlementLine[]

  @@index([bookingId, status])
  @@index([ownerProfileId, status])
  @@map("supplier_invoices")
}

/// One per VAT-registered supplier (research §11); ZATCA approval reference recorded per row.
model SelfBillingAgreement {
  id                      String    @id @db.Uuid
  ownerProfileId          String    @map("owner_profile_id") @db.Uuid
  supplierVatNumber       String    @map("supplier_vat_number") @db.VarChar(15)
  templateVersion         String    @map("template_version") @db.VarChar(16)
  signedDocumentId        String?   @map("signed_document_id") @db.Uuid
  effectiveFrom           DateTime? @map("effective_from") @db.Date
  expiresAt               DateTime? @map("expires_at") @db.Date
  acceptanceWindowDays    Int       @default(5) @map("acceptance_window_days") @db.SmallInt
  status                  String    @default("DRAFT") @db.VarChar(24)
  zatcaApprovalReference  String?   @map("zatca_approval_reference") @db.VarChar(128)
  zatcaSubmittedAt        DateTime? @map("zatca_submitted_at") @db.Timestamptz
  zatcaApprovedAt         DateTime? @map("zatca_approved_at") @db.Timestamptz
  zatcaApprovalDocumentId String?   @map("zatca_approval_document_id") @db.Uuid
  suspendedReason         String?   @map("suspended_reason")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  ownerProfile     OwnerProfile      @relation(fields: [ownerProfileId], references: [id])
  supplierInvoices SupplierInvoice[]

  @@index([ownerProfileId, status])
  @@map("self_billing_agreements")
}

model Expense {
  id                String    @id @db.Uuid
  ownerProfileId    String    @map("owner_profile_id") @db.Uuid
  vehicleId         String?   @map("vehicle_id") @db.Uuid
  driverProfileId   String?   @map("driver_profile_id") @db.Uuid
  tripId            String?   @map("trip_id") @db.Uuid
  expenseCategoryId String    @map("expense_category_id") @db.Uuid
  amount            Decimal   @db.Decimal(14, 2)
  vatAmount         Decimal   @default(0) @map("vat_amount") @db.Decimal(14, 2)
  totalAmount       Decimal   @map("total_amount") @db.Decimal(14, 2)
  currency          String    @default("SAR") @db.Char(3)
  expenseDate       DateTime  @map("expense_date") @db.Date
  description       String?
  vendorName        String?   @map("vendor_name") @db.VarChar(160)
  odometerKm        Int?      @map("odometer_km")
  receiptDocumentId String?   @map("receipt_document_id") @db.Uuid
  isReimbursable    Boolean   @default(false) @map("is_reimbursable")
  createdByUserId   String    @map("created_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  ownerProfile  OwnerProfile    @relation(fields: [ownerProfileId], references: [id])
