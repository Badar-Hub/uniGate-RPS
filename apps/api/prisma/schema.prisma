  extrasAmount             Decimal   @default(0) @map("extras_amount") @db.Decimal(14, 2)
  extrasBreakdown          Json?     @map("extras_breakdown")
  vatRate                  Decimal   @map("vat_rate") @db.Decimal(6, 4)
  vatAmount                Decimal   @map("vat_amount") @db.Decimal(14, 2)
  totalAmount              Decimal   @map("total_amount") @db.Decimal(14, 2)
  currency                 String    @default("SAR") @db.Char(3)
  estimatedArrivalAt       DateTime? @map("estimated_arrival_at") @db.Timestamptz
  estimatedDurationMinutes Int?      @map("estimated_duration_minutes")
