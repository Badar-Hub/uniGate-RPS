// iam
// ═════════════════════════════════════════════════════════════════════════════

model User {
  id                String     @id @db.Uuid
  email             String?    @db.Citext
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz
  phoneE164         String?    @map("phone_e164") @db.VarChar(20)
  phoneVerifiedAt   DateTime?  @map("phone_verified_at") @db.Timestamptz
  passwordHash      String?    @map("password_hash")
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz
  fullNameEn        String     @map("full_name_en") @db.VarChar(160)
  fullNameAr        String?    @map("full_name_ar") @db.VarChar(160)
  status            UserStatus @default(PENDING_VERIFICATION)
  preferredLocale   String     @default("ar") @map("preferred_locale") @db.VarChar(5)
  timezone          String     @default("Asia/Riyadh") @db.VarChar(64)
  permissionVersion Int        @default(1) @map("permission_version")
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz

  sessions                Session[]
  otpRequests             OtpRequest[]
  passwordResetTokens     PasswordResetToken[]
  userRoles               UserRole[]               @relation("UserRolesForUser")
  grantedRoles            UserRole[]               @relation("UserRolesGrantedBy")
  customerProfile         CustomerProfile?
  ownerProfile            OwnerProfile?
  driverProfile           DriverProfile?
  spoProfile              SpoProfile?
  documents               Document[]               @relation("DocumentUser")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  deviceTokens            DeviceToken[]
  exportJobs              ExportJob[]

  @@index([status])
  @@map("users")
}

model Session {
  id           String     @id @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  deviceId     String?    @map("device_id") @db.VarChar(128)
  deviceName   String?    @map("device_name") @db.VarChar(160)
  clientType   ClientType @map("client_type")
  userAgent    String?    @map("user_agent")
  ipAddress    String?    @map("ip_address") @db.Inet
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt   DateTime   @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz
  revokedAt    DateTime?  @map("revoked_at") @db.Timestamptz
  revokeReason String?    @map("revoke_reason") @db.VarChar(64)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("sessions")
}

model RefreshToken {
  id           String    @id @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique(map: "uq_refresh_tokens_token_hash") @map("token_hash") @db.Char(64)
  issuedAt     DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  usedAt       DateTime? @map("used_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  replacedById String?   @map("replaced_by_id") @db.Uuid

  session    Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken?  @relation("RefreshTokenReplacement", fields: [replacedById], references: [id])
  replaces   RefreshToken[] @relation("RefreshTokenReplacement")

  @@index([familyId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

model OtpRequest {
  id              String     @id @db.Uuid
  channel         OtpChannel
  destination     String     @db.VarChar(254)
  destinationHash String     @map("destination_hash") @db.Char(64)
  purpose         OtpPurpose
  codeHash        String     @map("code_hash") @db.Char(64)
  attemptCount    Int        @default(0) @map("attempt_count")
  maxAttempts     Int        @default(5) @map("max_attempts")
  expiresAt       DateTime   @map("expires_at") @db.Timestamptz
  consumedAt      DateTime?  @map("consumed_at") @db.Timestamptz
  ipAddress       String?    @map("ip_address") @db.Inet
  userId          String?    @map("user_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([destinationHash, createdAt], map: "idx_otp_destination_hash_created")
  @@map("otp_requests")
}

model PasswordResetToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "uq_password_reset_tokens_token_hash") @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model LoginAttempt {
  id             String   @id @db.Uuid
  identifier     String   @db.VarChar(254)
  identifierHash String   @map("identifier_hash") @db.Char(64)
  ipAddress      String?  @map("ip_address") @db.Inet
  userAgent      String?  @map("user_agent")
  succeeded      Boolean
  failureReason  String?  @map("failure_reason") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([identifierHash, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

model Permission {
  id            String  @id @db.Uuid
  code          String  @unique(map: "uq_permissions_code") @db.VarChar(64)
  module        String  @db.VarChar(32)
  descriptionEn String  @map("description_en")
  descriptionAr String  @map("description_ar")
  isAssignable  Boolean @default(true) @map("is_assignable")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id          String   @id @db.Uuid
  code        String   @unique(map: "uq_roles_code") @db.VarChar(48)
  nameEn      String   @map("name_en") @db.VarChar(120)
  nameAr      String   @map("name_ar") @db.VarChar(120)
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  grantedBy String?   @map("granted_by") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz
  expiresAt DateTime? @map("expires_at") @db.Timestamptz

  user    User  @relation("UserRolesForUser", fields: [userId], references: [id], onDelete: Cascade)
  role    Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  granter User? @relation("UserRolesGrantedBy", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@map("user_roles")
}

