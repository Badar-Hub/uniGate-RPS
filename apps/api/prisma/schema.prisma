  @@index([ownerProfileId, lifecycleStatus])
  @@index([vehicleCategoryId, approvalStatus, lifecycleStatus])
  @@index([plateNumberEn(ops: raw("gin_trgm_ops"))], map: "idx_vehicles_plate_trgm", type: Gin)
